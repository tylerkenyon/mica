# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory - run/, run/saves/New World, run/logs/, etc. Loom creates this
# when the client is launched from the working tree and we don't want the author's saved
# worlds or per-session logs in source control.
run
graphify-out/
.graphifyignore
.freebuff/

# Distribution artefacts - ./gradlew dist produces these.
dist/

# Personal client modules - kept locally for the author's tests, pushed to remote.
# The published library jar (built by :dist) strips this package, so dropping it from git
# keeps "no personal modules" enforcement at both the build and the history levels.
src/client/java/dev/technix/client/

# Author-side dev scripts - PowerShell helpers used during HUD testing. Not part of the
# library lifecycle, not built, just clutter from working trees.
mc-input.ps1
runs.ps1
sf-pro-display.zip

# Generated artefacts
src/tree.txt

# OS junk
Thumbs.db

# Internal progress journal - private to the author.
PROGRESS.md
